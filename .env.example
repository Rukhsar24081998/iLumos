# Gemini (Phase 4.2+) — server/script use only; never commit real keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Workspace AI mode: auto | live | mock
# auto = try Gemini via /api/ai/refine, fall back to mock on any failure (default)
# mock = always use mock suggestions (demo-safe, no key required)
# live = attempt Gemini only (still falls back to mock if the request fails)
NEXT_PUBLIC_AI_MODE=auto

# Optional: force AI debug logs (also on when NODE_ENV=development)
# AI_DEBUG=true
